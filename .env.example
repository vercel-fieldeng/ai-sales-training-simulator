# Required locally and on Vercel: AI Gateway only mints realtime client secrets
# with an API key (OIDC is rejected for that call).
AI_GATEWAY_API_KEY=

# Realtime voice model and voice. The same voice is used for every session.
REALTIME_MODEL=openai/gpt-realtime-2.1
REALTIME_VOICE=marin
# Transcribes the trainee's speech inside the realtime session.
INPUT_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Writes the rolling call summary carried into each new session.
SUMMARY_MODEL=google/gemini-3.8-flash
# Grades the finished call against lib/scoring/rubric.ts.
SCORING_MODEL=anthropic/claude-sonnet-5

# Realtime sessions on AI Gateway end at ~785s (13 min). Setting this to true
# adds ?extended-time=true for ~1785s sessions. That opt-in is an undocumented
# test feature with no stability guarantees; leave it off unless you've been
# told you can use it.
EXTENDED_TIME=false

# When to hand off to a fresh session, in seconds since the current one started.
#   soft: start looking for a quiet moment between turns
#   hard: hand off now, even mid-turn, before the server-side cutoff
# Production: 660 / 740 (or 1620 / 1740 with EXTENDED_TIME=true).
# The defaults below show a handoff after about 90 seconds.
HANDOFF_SOFT_SECONDS=90
HANDOFF_HARD_SECONDS=150
